DJANGO_SECRET_KEY=django-insecure-change-this-secret-key-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*

# CORS & CSRF Settings for IIS Deployment (Frontend Port 9191, Backend Port 8181)
CORS_ALLOWED_ORIGINS=http://localhost:9191,http://127.0.0.1:9191,http://localhost:8181,http://127.0.0.1:8181
CSRF_TRUSTED_ORIGINS=http://localhost:9191,http://127.0.0.1:9191,http://localhost:8181,http://127.0.0.1:8181
CORS_ALLOW_ALL_ORIGINS=False

# Extra origins for a deployed frontend on a different domain
# (only needed when the React build is NOT served by Django)
# CORS_EXTRA_ORIGINS=https://your-frontend.onrender.com
# CSRF_EXTRA_ORIGINS=https://your-frontend.onrender.com

# SSL settings (Set to True only if IIS has an SSL Certificate installed on HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Database Settings
POSTGRES_DB=FakeNewsDetection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# A single connection string. When set, it overrides the POSTGRES_* values
# above. Used by Render and by any remote PostgreSQL server.
# DATABASE_URL=postgresql://user:password@host:5432/FakeNewsDetection?sslmode=require
# DB_SSLMODE=require

# Set to true to serve the built React app from Django (one origin, no CORS).
# Build the frontend first: npm run build, then copy dist/ to backend/frontend_dist/
SERVE_FRONTEND=False

# Ask Render for these in the dashboard instead of committing them.
# SKIP_MIGRATE=true   # skip migrations during build

# External API Keys & Services
TAVILY_API_KEY=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
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b

# Support / contact form email (Gmail example)
# EMAIL_HOST=smtp.gmail.com
