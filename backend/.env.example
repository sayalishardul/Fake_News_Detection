DJANGO_SECRET_KEY=django-insecure-change-this-secret-key-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*

# --- Public deployment (Render/Railway/Fly/VPS) ---
# 1. Add your Vercel frontend origin here (exact scheme+host, no trailing slash),
#    e.g. https://fake-news-detection.vercel.app
# 2. Add your public backend host to DJANGO_ALLOWED_HOSTS (hosts only, no scheme),
#    e.g. fake-news-api.onrender.com
# CORS & CSRF — local (ports 8181/9191) + your Vercel origin
CORS_ALLOWED_ORIGINS=http://localhost:9191,http://127.0.0.1:9191,http://localhost:8181,http://127.0.0.1:8181,https://your-vercel-app.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:9191,http://127.0.0.1:9191,http://localhost:8181,http://127.0.0.1:8181,https://your-vercel-app.vercel.app
CORS_ALLOW_ALL_ORIGINS=False

# SSL settings (set True behind HTTPS / a proxy that sets X-Forwarded-Proto)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Database Settings
# Local SQLite fallback (settings.py default is Postgres on 127.0.0.1):
# leave these unset to use Postgres, or set POSTGRES_* for a hosted DB
# (Neon / Supabase / Render Postgres) using its connection details.
POSTGRES_DB=fake_news_detection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# External API Keys & Services
TAVILY_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
