# Local development (Django on port 9191)
VITE_API_BASE_URL=https://fake-news-detection-ng8h.onrender.com/api/

# Production (Vercel): do NOT commit the real value here.
# Vercel -> Project -> Settings -> Environment Variables -> add:
#   VITE_API_BASE_URL=https://<your-public-django-host>/api/
# e.g. https://fake-news-api.onrender.com/api/
# It must end with /api/ and point at a PUBLIC HTTPS Django server
# (Render / Railway / Fly.io / your VPS) — localhost:9191 will never work
# from a browser visiting *.vercel.app. Then Redeploy.
