# Copy this file to .env.local for local development overrides.
#
# Backend URL, including the trailing /api/.
#
#   Two-port local setup (Django on :9191, Vite on :5173):
VITE_API_BASE_URL=http://127.0.0.1:9191/api/
#
#   Both served from one origin (Django serves the built frontend):
# VITE_API_BASE_URL=/api/

# Optional: auto logout after N minutes of inactivity.
# VITE_SESSION_TIMEOUT_MINUTES=30
