# API base URL used by the production build (npm run build).
#
# "/api/" means "same origin as the page": use this when the React build is
# served by the Django service itself (SERVE_FRONTEND=true), or when a proxy
# on your host forwards /api to the backend.
#
# If the backend runs as a separate Render service, put its URL here instead,
# with the trailing /api/:
#   VITE_API_BASE_URL=https://fake-news-detection-api.onrender.com/api/
#
# Note: Vite reads this file for production builds only. Use .env.local for
# local overrides (that file is git-ignored).
VITE_API_BASE_URL=/api/
